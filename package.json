{
  "name": "vault",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run -w web clean",
    "sweep": "npm run clean && npm run lint && npm run build",
    "build": "npm run -ws build",
    "lint": "npm run lint --workspace=api --workspace=web",
    "test": "node scripts/test-all.mjs",
    "test:api": "npm -w @vault/db run build && npm -w api run test:api && npm -w api run test:html:api",
    "test:web": "npm -w web run test",
    "coverage": "npm run coverage --workspace=api --workspace=web",
    "coverage:api": "npm -w api run coverage",
    "coverage:web": "npm -w web run coverage",
    "web:dev": "npm run --workspace web dev",
    "web:build": "npm run --workspace web build",
    "api:dev": "npm run --workspace api dev",
    "api:build": "npm run --workspace api build",
    "prismagen": "npx prisma generate --schema packages/db/prisma/schema.prisma",
    "prismigrate": "npx prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prismareset": "npx prisma migrate reset --schema packages/db/prisma/schema.prisma",
    "boot": "concurrently -n API,WEB,WORKER -c auto \"npm -w api run dev\" \"npm -w web run dev\" \"npm -w api run worker:dev\"",
    "start": "npm run localdocker && concurrently -n API,WEB,WORKER -c auto \"npm -w api run start\" \"npm -w web run start\" \"npm -w api run worker\"",
    "localdocker": "docker compose -f infra/docker/docker-minimal.yml up -d",
    "docker:build": "docker compose -f infra/docker/docker-compose.yml up -d --build",
    "docker:rebuild-clean": "docker compose -f infra/docker/docker-compose.yml build --no-cache && docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "dockerup": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dockerdown": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "npm@10.5.0",
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.11",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.88",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "franc": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.4.1"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
