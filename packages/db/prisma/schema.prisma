generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  username     String?
  bio          String?
  website      String?
  location     String?
  avatarUrl    String?
  preferences       Json?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  // Bumped whenever the password is reset (admin CLI). Embedded in issued JWTs
  // as `tv`; the /auth/refresh path rejects tokens whose tv no longer matches,
  // evicting sessions that predate a password change.
  tokenVersion      Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  media        Media[]
  reminders    Reminder[]
  bundles      Bundle[]
  tags         Tag[]
  tagRules     TagRule[]
}

// A deterministic auto-tagging rule (the Tag Organizer). Rules are evaluated by
// the pure evaluateRules() engine (apps/api/src/lib/tags/rules/) at every ingest
// site and by the retroactive organize worker. `matcher` is a per-source JSON
// config validated by Zod at the API boundary; `tagTemplate` is the tag to
// apply, with `{value}` substituted by the rule's computed value (e.g.
// "type:{value}" → "type:pdf"). No AI/ML — sources are file facts only.
model TagRule {
  id          String        @id @default(cuid())
  userId      String
  name        String
  source      TagRuleSource
  matcher     Json          @default("{}")
  tagTemplate String
  priority    Int           @default(0)
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

enum TagRuleSource {
  MIME
  EXTENSION
  FILENAME
  PATH_SEGMENT
  FILE_DATE
  SIZE
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String?
  // USER = the user deliberately applied this tag; AUTO = the system applied it
  // (MIME-type tag on upload/index, bundle/extension tags on unpack). User intent
  // wins: a user-applied tag is promoted to USER and never auto-demoted.
  origin    TagOrigin @default(USER)
  count     Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, count(sort: Desc)])
}

model Media {
  id              String           @id @default(cuid())
  userId          String
  thumbState      MediaWorkerState @default(PENDING)
  thumbError      String?
  textState       MediaWorkerState @default(PENDING)
  sourceState     MediaWorkerState @default(PENDING)
  storageKey      String
  // Absolute path to the original file when it is indexed in place on a mounted
  // drive/NAS (see INDEX_ALLOWED_ROOTS). Null = the file lives in Vault-managed
  // storage at `storageKey` (normal upload). For in-place rows Vault reads the
  // source read-only and never writes to or deletes from this path.
  sourcePath      String?
  // Set when an in-place source stopped existing at `sourcePath`. The row is
  // kept intact (tags, title, starred, bundles, reminders, extracted text) so a
  // move or rename — which the OS reports as an unrelated unlink + add pair —
  // can be rematched to it instead of destroying the user's metadata. A sweeper
  // hard-deletes rows still missing after `missingFileGraceDays`.
  missingSince    DateTime?
  // Last known filesystem mtime of the source, in epoch ms. Deliberately
  // separate from `fileDate`, which starts as mtime but gets upgraded to the
  // embedded EXIF/PDF date — so fileDate cannot be trusted to identify a moved
  // file. Float because an epoch-ms value overflows Prisma's 32-bit Int.
  sourceMtimeMs   Float?
  filename        String
  mimeType        String
  sizeBytes       Float
  title           String
  // True once the user has renamed the item themselves. A move/rename then
  // preserves their title instead of re-deriving one from the new filename.
  titleIsUserEdited Boolean        @default(false)
  tags            String[]
  starred         Boolean          @default(false)
  starredAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  thumbnailKey    String?
  contentHash     String?
  // The file's own date (EXIF capture → PDF created → filesystem mtime; see
  // lib/tags/rules/fileDate.ts) — NOT the ingest time. Powers the "Year" sort.
  // Null when nothing trustworthy exists (e.g. an upload with no embedded date).
  fileDate        DateTime?
  linkedBundleId  String?
  linkedBundle    Bundle?          @relation("ArchiveLink", fields: [linkedBundleId], references: [id], onDelete: SetNull)
  isExtractedFromArchive Boolean   @default(false)
  sourceArchiveId String?
  sourceArchive   Media?           @relation("ExtractedFrom", fields: [sourceArchiveId], references: [id], onDelete: SetNull)
  extractedItems  Media[]          @relation("ExtractedFrom")
  sourcedBundles  Bundle[]         @relation("BundleSource")
  document        Document?
  extractedMetadata MediaExtractedMetadata?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       Reminder[]
  bundleItems     BundleItem[]

  @@unique([userId, sourcePath])
  @@index([tags], type: Gin)
  @@index([userId, contentHash])
  // Drives move rematching (recent tombstones) and the missing-file sweeper.
  @@index([userId, missingSince])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, fileDate(sort: Desc)])
  @@index([userId, title(sort: Asc)])
  @@index([userId, sizeBytes(sort: Desc)])
  @@index([userId, mimeType(sort: Asc)])
}

model Bundle {
  id            String       @id @default(cuid())
  userId        String
  name          String
  description   String?
  starred       Boolean      @default(false)
  starredAt     DateTime?
  coverMediaId  String?
  isUnpackedArchive Boolean   @default(false)
  sourceMediaId String?
  sourceMedia   Media?       @relation("BundleSource", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  linkedArchives Media[]     @relation("ArchiveLink")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         BundleItem[]

  @@index([userId])
}

model BundleItem {
  bundleId  String
  mediaId   String
  order     Int
  addedAt   DateTime @default(now())
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([bundleId, mediaId])
  @@index([bundleId, order])
}

model Document {
  mediaId      String  @id
  rawText      String
  searchVector Unsupported("tsvector")?
  pages        Json?
  textSource   TextSource?
  media        Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

enum TextSource {
  OCR
  NATIVE
}

enum MediaWorkerState {
  PENDING
  READY
  FAILED
  ERROR
  UNSUPPORTED
}

enum TagOrigin {
  USER
  AUTO
}

model MediaExtractedMetadata {
  mediaId     String   @id
  data        Json
  extractedAt DateTime @default(now())
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model Reminder {
  id             String         @id @default(uuid())
  userId         String
  title          String
  note           String?
  mediaId        String?
  status         ReminderStatus @default(ACTIVE)
  timezone       String
  dueAt          DateTime
  snoozedUntil   DateTime?
  remindOffsetDays Int?
  remindAt       DateTime
  rrule          String?
  nextDueAt      DateTime?
  lastCompletedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([userId, status, dueAt])
  @@index([userId, status, nextDueAt])
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELED
}
