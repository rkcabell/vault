generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  username     String?
  bio          String?
  website      String?
  location     String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  media        Media[]
  tags         Tag[]
  reminders    Reminder[]
}

model Media {
  id           String      @id @default(cuid())
  userId       String
  thumbState   MediaWorkerState @default(PENDING)
  thumbError   String?
  textState    MediaWorkerState @default(PENDING)
  sourceState  MediaWorkerState @default(PENDING)
  storageKey   String
  filename     String
  mimeType     String
  sizeBytes    Int
  title        String
  tags         String[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  thumbnailKey String?
  document     Document?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders    Reminder[]

  @@index([tags], type: Gin)
}

model Document {
  mediaId    String @id
  rawText    String
  pages      Json?
  textSource TextSource?
  media      Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

enum TextSource {
  OCR
  NATIVE
}

enum MediaWorkerState {
  PENDING
  READY
  FAILED
  ERROR
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Reminder {
  id             String         @id @default(uuid())
  userId         String
  title          String
  note           String?
  mediaId        String?
  status         ReminderStatus @default(ACTIVE)
  timezone       String
  dueAt          DateTime
  snoozedUntil   DateTime?
  remindOffsetDays Int?
  remindAt       DateTime
  rrule          String?
  nextDueAt      DateTime?
  lastCompletedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([userId, status, dueAt])
  @@index([userId, status, nextDueAt])
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELED
}
