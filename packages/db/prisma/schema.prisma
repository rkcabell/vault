generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  username     String?
  bio          String?
  website      String?
  location     String?
  avatarUrl    String?
  preferences       Json?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  media        Media[]
  reminders    Reminder[]
  bundles      Bundle[]
  tags         Tag[]
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  count     Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, count(sort: Desc)])
}

model Media {
  id              String           @id @default(cuid())
  userId          String
  thumbState      MediaWorkerState @default(PENDING)
  thumbError      String?
  textState       MediaWorkerState @default(PENDING)
  sourceState     MediaWorkerState @default(PENDING)
  storageKey      String
  filename        String
  mimeType        String
  sizeBytes       Int
  title           String
  tags            String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  thumbnailKey    String?
  contentHash     String?
  linkedBundleId  String?
  linkedBundle    Bundle?          @relation("ArchiveLink", fields: [linkedBundleId], references: [id], onDelete: SetNull)
  isExtractedFromArchive Boolean   @default(false)
  sourceArchiveId String?
  sourceArchive   Media?           @relation("ExtractedFrom", fields: [sourceArchiveId], references: [id], onDelete: SetNull)
  extractedItems  Media[]          @relation("ExtractedFrom")
  sourcedBundles  Bundle[]         @relation("BundleSource")
  document        Document?
  extractedMetadata MediaExtractedMetadata?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       Reminder[]
  bundleItems     BundleItem[]

  @@index([tags], type: Gin)
  @@index([userId, contentHash])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, title(sort: Asc)])
  @@index([userId, sizeBytes(sort: Desc)])
  @@index([userId, mimeType(sort: Asc)])
}

model Bundle {
  id            String       @id @default(cuid())
  userId        String
  name          String
  description   String?
  starred       Boolean      @default(false)
  starredAt     DateTime?
  coverMediaId  String?
  isUnpackedArchive Boolean   @default(false)
  sourceMediaId String?
  sourceMedia   Media?       @relation("BundleSource", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  linkedArchives Media[]     @relation("ArchiveLink")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         BundleItem[]

  @@index([userId])
}

model BundleItem {
  bundleId  String
  mediaId   String
  order     Int
  addedAt   DateTime @default(now())
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([bundleId, mediaId])
  @@index([bundleId, order])
}

model Document {
  mediaId    String @id
  rawText    String
  pages      Json?
  textSource TextSource?
  media      Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

enum TextSource {
  OCR
  NATIVE
}

enum MediaWorkerState {
  PENDING
  READY
  FAILED
  ERROR
}

model MediaExtractedMetadata {
  mediaId     String   @id
  data        Json
  extractedAt DateTime @default(now())
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model Reminder {
  id             String         @id @default(uuid())
  userId         String
  title          String
  note           String?
  mediaId        String?
  status         ReminderStatus @default(ACTIVE)
  timezone       String
  dueAt          DateTime
  snoozedUntil   DateTime?
  remindOffsetDays Int?
  remindAt       DateTime
  rrule          String?
  nextDueAt      DateTime?
  lastCompletedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([userId, status, dueAt])
  @@index([userId, status, nextDueAt])
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELED
}
