# Docker dev environment — copy to .env.docker before running docker-compose.yml.
# These defaults work out of the box for local dev.
# Generate new JWT secrets with: openssl rand -hex 32

HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_URL=postgresql://vault:vault@postgres:5432/vault?schema=public

# --- JWT (dev placeholders — change for any shared/deployed env) ---
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# --- Storage backend ---
# STORAGE_DRIVER selects where blobs (originals + thumbnails) are stored:
#   fs (default) — a filesystem path (mountable from a NAS share). See the
#                  "Filesystem storage" block below and docker-compose.fs.yml.
#   s3           — MinIO / any S3-compatible store, using the S3_* settings below.
# This dev example uses s3 (MinIO) since docker-compose.yml ships MinIO.
STORAGE_DRIVER=s3

# --- MinIO / S3 (used when STORAGE_DRIVER=s3) ---
MINIO_ROOT_USER=vault
MINIO_ROOT_PASSWORD=vaultvault
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vault
S3_SECRET_ACCESS_KEY=vaultvault
S3_BUCKET=vault-media
S3_FORCE_PATH_STYLE=true

# --- Filesystem storage (used when STORAGE_DRIVER=fs) ---
# To use the filesystem/NAS backend, set STORAGE_DRIVER=fs above and uncomment
# STORAGE_FS_PATH below. In fs mode the entire MinIO/S3 block above can be deleted
# (only S3_BUCKET has a default and it is ignored). For a ready-made minimal fs
# config, see .env.docker.fs.example (pairs with docker-compose.fs.yml).
# Absolute path inside the API/worker containers where blobs are written; point
# the matching volume at a local disk or a mounted NAS share (NFS/SMB).
# STORAGE_FS_PATH=/data/vault

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
