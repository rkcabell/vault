# Docker dev environment — copy to .env.docker before running docker-compose.yml.
# These defaults work out of the box for local dev.
# Generate new JWT secrets with: openssl rand -hex 32

HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_URL=postgresql://vault:vault@postgres:5432/vault?schema=public

# --- JWT (dev placeholders — change for any shared/deployed env) ---
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# --- Registration lock ---
# After creating your account, set this to true so nobody else who can reach
# the server can register a second one.
# DISABLE_REGISTRATION=true

# --- Storage ---
# Absolute path inside the API/worker containers where blobs (originals +
# thumbnails) are written. docker-compose.yml mounts the vault-data volume here;
# repoint that volume at a local disk or a mounted NAS share (NFS/SMB).
STORAGE_FS_PATH=/data/vault

# --- In-place indexing (optional) ---
# Comma-separated absolute directories Vault may index WITHOUT copying — it reads
# originals in place (read-only) and writes only thumbnails + OCR to its own
# storage. Empty/unset disables the feature. Mount each root (ideally read-only)
# into the api and worker containers, e.g.:
#     volumes:
#       - /mnt/nas/photos:/mnt/nas/photos:ro
# INDEX_ALLOWED_ROOTS=/mnt/nas/photos,/mnt/nas/documents

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
