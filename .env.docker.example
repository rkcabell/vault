# Docker dev environment — copy to .env.docker before running docker-compose.yml.
# These defaults work out of the box for local dev.
# Generate new JWT secrets with: openssl rand -hex 32

HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_URL=postgresql://vault:vault@postgres:5432/vault?schema=public

# --- JWT (dev placeholders — change for any shared/deployed env) ---
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# --- MinIO / S3 ---
MINIO_ROOT_USER=vault
MINIO_ROOT_PASSWORD=vaultvault
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vault
S3_SECRET_ACCESS_KEY=vaultvault
S3_BUCKET=vault-media
S3_FORCE_PATH_STYLE=true

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
