{
  "name": "api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker/ocrWorker.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "thumb": "tsx src/worker/thumbWorker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "@vault/db": "*",
    "argon2": "^0.44.0",
    "bullmq": "^5.66.4",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^6.17.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
