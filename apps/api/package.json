{
  "name": "api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:ocr:dev": "tsx watch src/worker/ocr.ts",
    "worker:thumb:dev": "tsx watch src/worker/thumb.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:ocr": "tsx src/worker/ocr.ts",
    "worker:thumb": "tsx src/worker/thumb.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p . --extendedDiagnostics && tsc-alias -p tsconfig.json",
    "build:worker": "tsc -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "thumb": "tsx src/worker/thumbWorker.ts",
    "test": "c8 --all --src src --exclude \"src/tests/**\" --exclude \"src/**/*.test.ts\" --reporter=text-summary --reporter=lcov --reporter=html --reporter=json-summary --report-dir coverage node scripts/run-tests.mjs src/tests",
    "test:api": "node scripts/run-tests.mjs src/tests/api",
    "test:worker": "node scripts/run-tests.mjs src/tests/api/worker",
    "test:web": "node scripts/run-tests.mjs src/tests/web",
    "test:html": "node scripts/run-tests-html.mjs src/tests",
    "test:html:api": "node scripts/run-tests-html.mjs src/tests/api",
    "log": "tsx scripts/logtail.ts",
    "log:watch": "tsx scripts/logtail.ts --watch",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/sensible": "^5.6.0",
    "@napi-rs/canvas": "^0.1.88",
    "@prisma/client": "^6.19.1",
    "@vault/db": "workspace:*",
    "@vault/types": "workspace:*",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.66.4",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "franc": "^6.2.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.14.0",
    "sharp": "^0.34.4",
    "tar": "^7.4.3",
    "unzipper": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/archiver": "^7.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/tar": "^6.1.13",
    "@types/unzipper": "^0.10.10",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.0"
  }
}
