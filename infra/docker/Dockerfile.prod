# syntax=docker/dockerfile:1.6
# Production multi-stage build — no source bind-mounts, compiled output only.

# ---------------------------------------------------------------------------
# base: minimal Node runtime shared by all stages
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# ---------------------------------------------------------------------------
# deps: install all workspace dependencies (including devDeps needed for build)
# packages/db postinstall runs `prisma generate` automatically
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json    apps/api/
COPY apps/web/package.json    apps/web/
COPY packages/db/package.json     packages/db/
COPY packages/types/package.json  packages/types/
# Copy the schema so packages/db postinstall (`prisma generate`) can find it.
COPY packages/db/prisma/schema.prisma packages/db/prisma/schema.prisma
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# builder: compile everything
# ---------------------------------------------------------------------------
FROM deps AS builder
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/web/ apps/web/

# 1. Build shared packages
RUN pnpm -F @vault/types run build
RUN pnpm -F @vault/db run build

# 2. Compile the Fastify API + workers (tsc + tsc-alias rewrites @/ paths → dist/)
#    The build script also copies fileTransport.mjs into dist/.
RUN pnpm -F api run build

# 3. Build Next.js (emits .next/standalone because output:'standalone' is set)
# API_BASE_URL is baked into routes-manifest.json at build time by next.config.mjs rewrites().
# The default points at the `api` service name used in docker-compose.prod.yml.
ARG API_BASE_URL=http://api:8000
ENV API_BASE_URL=$API_BASE_URL
RUN pnpm -F web run build

# ---------------------------------------------------------------------------
# api-prod-deps: lean production node_modules via pnpm deploy
# pnpm deploy creates a self-contained directory — real files, no symlinks,
# safe to COPY into the final image without breaking workspace resolution.
# ---------------------------------------------------------------------------
FROM deps AS api-prod-deps
COPY packages/ packages/
COPY apps/api/ apps/api/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm --filter api deploy --prod /deploy/api
# sharp and @napi-rs/canvas linux binaries may be absent from a Windows-generated
# lock file — install them explicitly if needed.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    cd /deploy/api && pnpm add --no-save \
        "@img/sharp-linux-x64@0.34.5" \
        "@img/sharp-libvips-linux-x64@1.2.4" \
        "@napi-rs/canvas-linux-x64-gnu@0.1.89"

# ---------------------------------------------------------------------------
# api: production API image
# ---------------------------------------------------------------------------
FROM base AS api
WORKDIR /app

# Production node_modules from pnpm deploy (flat, no symlinks)
COPY --from=api-prod-deps /deploy/api/node_modules ./node_modules

# Compiled API output
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Prisma-generated client — copy from builder where prisma generate ran
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Workspace packages — package.json needed so Node resolves the main field
COPY packages/db/package.json               ./packages/db/package.json
COPY --from=builder /app/packages/db/dist   ./packages/db/dist
COPY packages/types/package.json            ./packages/types/package.json
COPY --from=builder /app/packages/types/dist ./packages/types/dist

# Prisma schema + migrations (needed by prisma migrate deploy in entrypoint)
COPY packages/db/prisma ./packages/db/prisma

# Startup entrypoint (runs migrations, then starts the server)
COPY --chmod=755 infra/docker/entrypoint-api.sh ./entrypoint-api.sh

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint-api.sh"]

# ---------------------------------------------------------------------------
# web: production Next.js standalone image
# ---------------------------------------------------------------------------
FROM base AS web
WORKDIR /app

# Next.js standalone server includes its own trimmed node_modules
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static      ./apps/web/.next/static
COPY --from=builder /app/apps/web/public            ./apps/web/public

EXPOSE 3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]

# ---------------------------------------------------------------------------
# jobs: worker image — api + OCR system packages
# ---------------------------------------------------------------------------
FROM api AS jobs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ocrmypdf tesseract-ocr ghostscript qpdf curl \
    && rm -rf /var/lib/apt/lists/*

# Override the api entrypoint; CMD is set per-service in docker-compose.prod.yml
ENTRYPOINT []
CMD ["node", "apps/api/dist/worker/index.js"]
