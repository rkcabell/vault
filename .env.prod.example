# Production environment — copy to .env.prod and fill in all CHANGE_ME values.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production

# --- API server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=https://your-domain.com

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_URL=postgresql://vault:CHANGE_ME@postgres:5432/vault

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# --- Registration lock ---
# After creating your account, set this to true so nobody else who can reach
# the server can register a second one.
# DISABLE_REGISTRATION=true

# --- Storage ---
# Absolute path inside the API/worker containers where blobs (originals +
# thumbnails) are written. docker-compose.prod.yml mounts the vault-data volume
# here; repoint that volume at a local disk or a mounted NAS share (NFS/SMB).
STORAGE_FS_PATH=/data/vault

# --- In-place indexing (optional) ---
# Comma-separated absolute directories Vault may index WITHOUT copying — it reads
# originals in place (read-only) and writes only thumbnails + OCR to its own
# storage. Empty/unset disables the feature. Mount each root (ideally read-only)
# into the api and worker containers.
# INDEX_ALLOWED_ROOTS=/mnt/nas/photos,/mnt/nas/documents

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
