# Production environment — copy to .env.prod and fill in all CHANGE_ME values.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production

# --- API server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=https://your-domain.com

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_URL=postgresql://vault:CHANGE_ME@postgres:5432/vault

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# --- Storage backend ---
# fs (default) stores blobs on a filesystem path (mountable from a NAS share) —
# see STORAGE_FS_PATH and docker-compose.fs.yml. s3 uses the MinIO/S3 settings
# below. This example uses s3; set STORAGE_DRIVER=fs to use the filesystem.
STORAGE_DRIVER=s3

# --- MinIO / S3 (used when STORAGE_DRIVER=s3) ---
MINIO_ROOT_USER=vault
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://your-domain.com:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vault
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=vault-media
S3_FORCE_PATH_STYLE=true

# --- Filesystem storage (used when STORAGE_DRIVER=fs) ---
# Set STORAGE_DRIVER=fs above and uncomment STORAGE_FS_PATH below. In fs mode the
# MinIO/S3 block above can be deleted entirely (it is unused).
# Absolute path inside the API/worker containers; back it with a local disk or a
# mounted NAS share (NFS/SMB). Required when STORAGE_DRIVER=fs.
# STORAGE_FS_PATH=/data/vault

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
