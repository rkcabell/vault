# Production environment — copy to .env.prod and fill in all CHANGE_ME values.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production

# --- API server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=https://your-domain.com

# --- Postgres ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_URL=postgresql://vault:CHANGE_ME@postgres:5432/vault

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# --- MinIO / S3 ---
MINIO_ROOT_USER=vault
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://your-domain.com:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vault
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=vault-media
S3_FORCE_PATH_STYLE=true

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Internal routing (server-side only, not exposed to browser) ---
# Next.js uses this to forward /api/* rewrite requests to the API container.
API_BASE_URL=http://api:8000
